rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function createsNoPrivilegedFields() {
      return !request.resource.data.keys().hasAny(["role", "has_premium_ai", "premium_type", "is_admin"]);
    }

    function keepsPrivilegedFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.has_premium_ai == resource.data.has_premium_ai
        && request.resource.data.premium_type == resource.data.premium_type
        && request.resource.data.is_admin == resource.data.is_admin;
    }
    
    // Herkesin kendi hesabına tam erişimi var
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && createsNoPrivilegedFields();
      allow update: if isOwner(userId) && keepsPrivilegedFieldsUnchanged();
      allow delete: if false;
    }

    // Görevler ve Denetimler için "Kişisel Alan" / "Ortak Alan" (is_public=true) mantığı
    match /audits/{auditId} {
      // Bir rapor eğer is_public == true ise herkes OKUYABİLİR
      allow read: if request.auth != null && (
        resource.data.is_public == true || 
        resource.data.owner_id == request.auth.uid
      );
      
      // Oluşturma, Güncelleme veya Silme için sahibi olmak DİREKT şarttır.
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null && (
        resource.data.is_public == true || 
        resource.data.owner_id == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
    }

    // Ortak chat paneli: herkes okuyabilir, sadece kendi mesajını oluşturabilir/silebilir
    match /chat_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.author_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.author_id == request.auth.uid;
      allow update: if false;
    }

    // Takvim notları: sadece sahibi erişebilir (backend Admin SDK üzerinden yazılır)
    match /calendar_notes/{noteId} {
      allow read, delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow update: if false;
    }

    // Sistem ayarları (Sürüm kontrolü vb. için)
    match /system/{document=**} {
      allow read: if isSignedIn();
    }
  }
}
